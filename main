-- ================= SCRIPT HUB =================
local function OpenHub()
	Frame:Destroy()

	local Hub = Instance.new("Frame", ScreenGui)
	Hub.Size = UDim2.new(0,420,0,320)
	Hub.Position = UDim2.new(0.5,-210,0.5,-160)
	Hub.BackgroundColor3 = Color3.fromRGB(10,10,10)
	Instance.new("UICorner", Hub)

	local Stroke2 = Instance.new("UIStroke", Hub)
	Stroke2.Thickness = 2

	spawn(function()
		while true do
			for i=0,1,0.01 do
				Stroke2.Color = Color3.fromHSV(i,1,1)
				task.wait(0.03)
			end
		end
	end)

	local Title2 = Instance.new("TextLabel", Hub)
	Title2.Size = UDim2.new(1,0,0,50)
	Title2.Text = "🔥 SCRIPT HUB"
	Title2.Font = Enum.Font.GothamBlack
	Title2.TextSize = 26
	Title2.TextColor3 = Color3.new(1,1,1)
	Title2.BackgroundTransparency = 1

	local List = Instance.new("Frame", Hub)
	List.Size = UDim2.new(1,-20,1,-60)
	List.Position = UDim2.new(0,10,0,50)
	List.BackgroundTransparency = 1

	local UIList = Instance.new("UIListLayout", List)
	UIList.Padding = UDim.new(0,10)

	-- 🔥 CREATE SCRIPT FUNCTION
	local function CreateScript(name, code)
		local Item = Instance.new("Frame", List)
		Item.Size = UDim2.new(1,0,0,50)
		Item.BackgroundColor3 = Color3.fromRGB(20,20,20)
		Instance.new("UICorner", Item)

		local Label = Instance.new("TextLabel", Item)
		Label.Size = UDim2.new(0.6,0,1,0)
		Label.Position = UDim2.new(0,10,0,0)
		Label.Text = name
		Label.Font = Enum.Font.GothamBold
		Label.TextSize = 18
		Label.TextColor3 = Color3.new(1,1,1)
		Label.BackgroundTransparency = 1
		Label.TextXAlignment = Enum.TextXAlignment.Left

		local Run = Instance.new("TextButton", Item)
		Run.Size = UDim2.new(0,60,0,40)
		Run.Position = UDim2.new(1,-70,0.5,-20)
		Run.Text = "▶"
		Run.Font = Enum.Font.GothamBlack
		Run.TextSize = 22
		Run.BackgroundColor3 = Color3.fromRGB(25,25,25)
		Run.TextColor3 = Color3.new(1,1,1)
		Instance.new("UICorner", Run)

		Run.MouseButton1Click:Connect(function()
			TweenService:Create(Run, TweenInfo.new(0.3), {Rotation = 360}):Play()
			Run.Text = "..."
			task.wait(0.3)
			ScreenGui:Destroy()
			loadstring(code)()
		end)
	end

	-- 🔥 สคริปที่มึงให้มา
	CreateScript("Quantum HUB", [[
loadstring(game:HttpGet("https://raw.githubusercontent.com/flazhy/QuantumOnyx/refs/heads/main/QuantumOnyx.lua"))()
]])

	CreateScript("Trade Scam", [[
loadstring(game:HttpGet("https://raw.githubusercontent.com/panumas13119/Dds/refs/heads/main/dupe"))()
]])

	CreateScript("RedZ HUB", [[
loadstring(game:HttpGet("https://raw.githubusercontent.com/PlockScripts/newredz/refs/heads/main/Remake-version.luau"))()
]])
end

-- CHECK KEY
Button.MouseButton1Click:Connect(function()
	if TextBox.Text == CorrectKey then
		Button.Text = "SUCCESS!"
		task.wait(0.5)
		OpenHub()
	else
		Button.Text = "WRONG KEY"
	end
end)
